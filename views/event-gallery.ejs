<%- include('partials/head') %>
<%- include('partials/header') %>

<section class="card form-card">
  <div>
    <p class="eyebrow">Galerie de l'événement</p>
    <h1>Les photos partagées</h1>
    <p>Touchez une photo pour l'ouvrir en grand format.</p>
  </div>

  <% if (!galleryFiles.length) { %>
    <div class="empty-state">
      <strong>Aucune photo disponible pour le moment.</strong>
      <p>Soyez le premier à partager un souvenir de l'événement.</p>
    </div>
  <% } else { %>
    <div class="event-gallery-grid">
      <% galleryFiles.forEach((fileItem) => { %>
        <article class="event-gallery-card">
          <a href="<%= fileItem.urls.xl || fileItem.urls.original %>" target="_blank" rel="noopener noreferrer">
            <img
              src="<%= fileItem.urls.sm || fileItem.urls.md || fileItem.urls.original %>"
              alt="<%= fileItem.originalName %>"
              loading="lazy"
            />
          </a>
          <div class="event-gallery-meta">
            <strong><%= fileItem.originalName %></strong>
            <small>
              <%= fileItem.isProcessed ? 'Version optimisée disponible' : 'Optimisation en cours…' %>
            </small>
          </div>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>

<%- include('partials/footer') %>
