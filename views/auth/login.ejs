<%- include('../partials/head') %>
<%- include('../partials/header') %>
<section class="card form-card auth-card">
  <div>
    <p class="eyebrow">Espace organisateur</p>
    <h1>Bon retour</h1>
    <p>Connectez-vous pour gérer vos événements et récupérer vos photos.</p>
  </div>
  <form method="post" action="/login" class="form-grid">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <label>
      <span>Email</span>
      <input type="email" name="email" value="<%= formData.email || '' %>" required maxlength="190" autocomplete="email" />
      <% if (fieldErrors.email) { %><small class="field-error"><%= fieldErrors.email %></small><% } %>
    </label>

    <label>
      <span>Mot de passe</span>
      <input type="password" name="password" required maxlength="72" autocomplete="current-password" />
      <% if (fieldErrors.password) { %><small class="field-error"><%= fieldErrors.password %></small><% } %>
    </label>

    <button class="btn btn-lg" type="submit">Se connecter</button>
  </form>
  <p class="auth-alt">Pas encore de compte ? <a href="/register">Créer un compte</a></p>
</section>
<%- include('../partials/footer') %>
