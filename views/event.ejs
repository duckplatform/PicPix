<%- include('partials/head') %>
<%- include('partials/header') %>
<section class="hero countdown-layout event-hero">
  <p class="eyebrow">Vous êtes invité</p>
  <div class="richtext-content"><%- renderedDescriptionHtml %></div>
  <p class="event-date"><%- include('partials/icon', { name: 'calendar', size: 18 }) %><span>Début : <strong><%= formatDateTime(eventItem.startsAt) %></strong></span></p>
  <div class="hero-actions">
    <a class="btn btn-lg" href="/event/<%= eventItem.token %>/upload"><%- include('partials/icon', { name: 'camera', size: 18 }) %>Déposer des photos</a>
    <a class="btn btn-secondary btn-lg" href="/event/<%= eventItem.token %>/gallery"><%- include('partials/icon', { name: 'images', size: 18 }) %>Voir la galerie</a>
  </div>

  <section id="countdownScreen" class="countdown-screen" aria-live="polite" <%= shouldShowCountdown ? '' : 'hidden' %>>
    <h2>L'événement commence bientôt</h2>
    <p>Temps restant avant l'ouverture</p>
    <div id="countdownValue" class="countdown-value">--:--:--</div>
  </section>

  <section id="welcomeScreen" class="welcome-screen" aria-live="polite" <%= shouldShowCountdown ? 'hidden' : '' %>>
    <h2>C'est parti</h2>
    <p>L'événement a commencé : partagez vos plus belles photos au fil de la journée.</p>
  </section>
</section>

<section class="card form-card section-gap">
  <div>
    <p class="eyebrow">Archive photos</p>
    <h2>Recevoir toutes les photos</h2>
    <p>Recevez par email le lien de téléchargement de l'archive complète, dès qu'elle sera générée à la clôture de l'événement.</p>
  </div>

  <form method="post" action="/event/<%= eventItem.token %>/archive-request" class="form-grid">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <label>
      <span class="checkbox-label">
        <input type="checkbox" id="archiveRequestCheckbox" name="wantsArchive" value="1" <%= archiveRequestEmail ? 'checked' : '' %> />
        Je souhaite recevoir l'archive des photos par email à la fin de l'événement
      </span>
    </label>

    <label id="archiveRequestEmailField" <%= archiveRequestEmail ? '' : 'hidden' %>>
      <span>Votre email</span>
      <input type="email" name="email" value="<%= archiveRequestEmail || '' %>" maxlength="190" autocomplete="email" />
    </label>

    <button class="btn btn-secondary" type="submit">Enregistrer ma préférence</button>
  </form>
</section>

<script>
  (function initArchiveRequestForm() {
    const checkbox = document.getElementById('archiveRequestCheckbox');
    const emailField = document.getElementById('archiveRequestEmailField');
    if (!checkbox || !emailField) {
      return;
    }

    checkbox.addEventListener('change', () => {
      emailField.hidden = !checkbox.checked;
    });
  }());
</script>

<script>
  (function initEventStatus() {
    const startsAtIso = '<%= eventStartsAtIso || '' %>';
    const startsAt = startsAtIso ? new Date(startsAtIso) : null;
    const shouldShowCountdown = <%= shouldShowCountdown ? 'true' : 'false' %>;
    const countdownScreen = document.getElementById('countdownScreen');
    const welcomeScreen = document.getElementById('welcomeScreen');
    const countdownValue = document.getElementById('countdownValue');

    function formatRemaining(ms) {
      const totalSeconds = Math.max(0, Math.floor(ms / 1000));
      const days = Math.floor(totalSeconds / 86400);
      const hours = Math.floor((totalSeconds % 86400) / 3600);
      const minutes = Math.floor((totalSeconds % 3600) / 60);
      const seconds = totalSeconds % 60;

      return `${String(days).padStart(2, '0')}j ${String(hours).padStart(2, '0')}h ${String(minutes).padStart(2, '0')}m ${String(seconds).padStart(2, '0')}s`;
    }

    function switchToWelcome() {
      countdownScreen.hidden = true;
      welcomeScreen.hidden = false;
    }

    function tick() {
      if (!startsAt) {
        switchToWelcome();
        return;
      }

      const now = new Date();
      const diff = startsAt.getTime() - now.getTime();

      if (diff <= 0) {
        switchToWelcome();
        return;
      }

      countdownValue.textContent = formatRemaining(diff);
      setTimeout(tick, 1000);
    }

    if (!shouldShowCountdown) {
      switchToWelcome();
      return;
    }

    const initialNow = new Date('<%= nowIso %>');
    if (!startsAt || startsAt.getTime() <= initialNow.getTime()) {
      switchToWelcome();
      return;
    }

    tick();
  }());
</script>
<%- include('partials/footer') %>
