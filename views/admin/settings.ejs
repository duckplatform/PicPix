<%- include('../partials/head') %>
<%- include('../partials/header') %>
<section class="card admin-header">
  <div>
    <p class="eyebrow">Administration</p>
    <h1>Réglages</h1>
    <p>Paramètres globaux de l'application.</p>
  </div>
  <div class="table-actions">
    <a class="btn btn-secondary" href="/admin">Retour à l'administration</a>
  </div>
</section>

<section class="card form-card">
  <h2>Notifications email</h2>
  <p>
    Lorsqu'un événement est clôturé définitivement et que son archive ZIP est
    prête, les invités ayant demandé à la recevoir peuvent être notifiés par
    email avec le lien de téléchargement.
  </p>

  <% if (!mailEnvConfigured) { %>
    <p class="field-error">
      Aucun serveur SMTP n'est configuré (variable SMTP_HOST manquante) : même
      activée, cette option n'enverra aucun email.
    </p>
  <% } %>

  <% if (!mailBaseUrlConfigured) { %>
    <p class="field-error">
      La variable APP_BASE_URL (URL publique absolue du site, ex.
      https://picpix.example.com) n'est pas définie : les liens envoyés par
      email seraient inutilisables, aucun email ne sera donc envoyé.
    </p>
  <% } %>

  <form method="post" action="/admin/settings" class="form-grid">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <label>
      <span class="checkbox-label">
        <input type="checkbox" name="mailNotificationsEnabled" value="1" <%= mailNotificationsEnabled ? 'checked' : '' %> />
        Envoyer automatiquement l'archive ZIP par email aux inscrits lors de la clôture d'un événement
      </span>
    </label>

    <button class="btn" type="submit">Enregistrer</button>
  </form>
</section>
<%- include('../partials/footer') %>
