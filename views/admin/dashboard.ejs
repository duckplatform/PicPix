<%- include('../partials/head') %>
<%- include('../partials/header') %>
<% const badgeLabels = { admin: 'Admin', user: 'Utilisateur', active: 'Actif', inactive: 'Inactif', disabled: 'Désactivé', closed: 'Clôturé' }; %>
<section class="card admin-header">
  <div>
    <p class="eyebrow">Administration</p>
    <h1>Gestion des utilisateurs</h1>
    <p>Comptes, profils et droits d'accès.</p>
  </div>
  <div class="table-actions">
    <a class="btn" href="/admin/users/new">Ajouter un utilisateur</a>
    <a class="btn btn-secondary" href="/admin/events/new">Ajouter un événement</a>
    <a class="btn btn-secondary" href="/admin/settings">Réglages</a>
  </div>
</section>

<section class="card table-card">
  <table class="data-table">
    <thead>
      <tr>
        <th>Nom</th>
        <th>Email</th>
        <th>Rôle</th>
        <th>Statut</th>
        <th>Dernière connexion</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% users.forEach((item) => { %>
        <tr>
          <td><%= item.fullName %></td>
          <td><%= item.email %></td>
          <td><span class="badge badge-<%= item.role %>"><%= badgeLabels[item.role] || item.role %></span></td>
          <td><span class="badge badge-<%= item.status %>"><%= badgeLabels[item.status] || item.status %></span></td>
          <td><%= item.lastLoginAt ? formatDateTime(item.lastLoginAt) : 'Jamais' %></td>
          <td>
            <div class="table-actions">
              <a class="btn btn-secondary btn-small" href="/admin/users/<%= item.id %>/edit">Modifier</a>
              <form method="post" action="/admin/users/<%= item.id %>?_method=DELETE" class="inline-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <button class="btn btn-danger btn-small" type="submit">Supprimer</button>
              </form>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>

<section class="card admin-header section-gap">
  <div>
    <p class="eyebrow">Administration</p>
    <h2>Gestion des événements</h2>
    <p>Tous les événements créés par les utilisateurs.</p>
  </div>
</section>

<section class="card table-card">
  <div class="table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          <th>Nom</th>
          <th>Propriétaire</th>
          <th>Date/heure</th>
          <th>Statut</th>
          <th>Archive photos</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% events.forEach((eventItem) => { %>
          <% const isClosed = eventItem.status === 'closed'; %>
          <tr>
            <td>
              <%= eventItem.name %>
              <% if (isClosed && eventItem.closedAt) { %>
                <small class="muted-note">Clôturé le <%= formatDateTime(eventItem.closedAt) %></small>
              <% } %>
            </td>
            <td><%= eventItem.ownerFullName %> (<%= eventItem.ownerEmail %>)</td>
            <td><%= formatDateTime(eventItem.startsAt) %></td>
            <td><span class="badge badge-<%= eventItem.status %>"><%= badgeLabels[eventItem.status] || eventItem.status %></span></td>
            <td>
              <% if (!isClosed) { %>
                <span class="muted-note">&mdash;</span>
              <% } else if (eventItem.archiveStatus === 'ready') { %>
                <a class="btn btn-small" href="/admin/events/<%= eventItem.id %>/archive">Télécharger le ZIP</a>
                <small class="muted-note">
                  <%= eventItem.archivePhotoCount || 0 %> photo(s)<% if (eventItem.archiveSizeBytes) { %> &middot; <%= (eventItem.archiveSizeBytes / (1024 * 1024)).toFixed(1) %> Mo<% } %>
                </small>
              <% } else if (eventItem.archiveStatus === 'failed') { %>
                <span class="archive-failed" title="<%= eventItem.archiveError || '' %>">Échec de génération</span>
                <form method="post" action="/admin/events/<%= eventItem.id %>/archive/retry" class="inline-form">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button class="btn btn-secondary btn-small" type="submit">Relancer</button>
                </form>
              <% } else { %>
                <span class="archive-pending">
                  <span class="archive-spinner" aria-hidden="true"></span>
                  Préparation en cours&hellip;
                </span>
              <% } %>
            </td>
            <td>
              <div class="table-actions">
                <a class="btn btn-small" href="/event/<%= eventItem.token %>" target="_blank" rel="noopener noreferrer">Site</a>
                <% if (!isClosed) { %>
                  <a class="btn btn-secondary btn-small" href="/admin/events/<%= eventItem.id %>/edit">Modifier</a>
                <% } %>
                <form method="post" action="/admin/events/<%= eventItem.id %>?_method=DELETE" class="inline-form" onsubmit="return confirm('Supprimer cet événement ? Cette action supprimera aussi toutes les données stockées de cet événement.');">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button class="btn btn-danger btn-small" type="submit">Supprimer</button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
<%- include('../partials/footer') %>