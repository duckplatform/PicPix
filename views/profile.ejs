<%- include('partials/head') %>
<%- include('partials/header') %>
<% const badgeLabels = { admin: 'Admin', user: 'Utilisateur', active: 'Actif', inactive: 'Inactif', disabled: 'Désactivé', closed: 'Clôturé' }; %>
<section class="section-head profile-head">
  <div class="profile-identity">
    <span class="avatar" aria-hidden="true"><%= (user.fullName || user.email || '?').trim().charAt(0).toUpperCase() %></span>
    <div>
      <h1>Mes événements</h1>
      <p><%= user.fullName %> · <%= user.email %></p>
    </div>
  </div>
  <a class="btn btn-accent btn-lg" href="/profile/events/new"><%- include('partials/icon', { name: 'plus', size: 18 }) %>Nouvel événement</a>
</section>

<section class="profile-events" aria-label="Liste de mes événements">
  <% if (!userEvents.length) { %>
    <div class="empty-state">
      <strong>Aucun événement pour le moment.</strong>
      <p>Créez votre premier événement pour obtenir un lien à partager avec vos invités.</p>
      <a class="btn section-gap" href="/profile/events/new">Créer un événement</a>
    </div>
  <% } else { %>
    <ul class="event-list">
      <% userEvents.forEach((eventItem) => { %>
        <% const isClosed = eventItem.status === 'closed'; %>
        <li class="event-row">
          <div>
            <h3 class="event-row-title">
              <%= eventItem.name %>
              <span class="badge badge-<%= eventItem.status %>"><%= badgeLabels[eventItem.status] || eventItem.status %></span>
            </h3>
            <p class="event-row-meta">
              <span><%- include('partials/icon', { name: 'calendar', size: 15 }) %><%= formatDateTime(eventItem.startsAt) %></span>
              <% if (isClosed && eventItem.closedAt) { %>
                <span><%- include('partials/icon', { name: 'lock', size: 15 }) %>Clôturé le <%= formatDateTime(eventItem.closedAt) %></span>
              <% } %>
              <% if (!isClosed && eventItem.pendingModerationCount) { %>
                <span><%- include('partials/icon', { name: 'clock', size: 15 }) %><%= eventItem.pendingModerationCount %> photo(s) à modérer</span>
              <% } %>
            </p>
          </div>

          <div class="event-row-actions">
            <a class="btn btn-small" href="/event/<%= eventItem.token %>" target="_blank" rel="noopener noreferrer"><%- include('partials/icon', { name: 'external', size: 16 }) %>Site invité</a>
            <a class="btn btn-secondary btn-small" href="/profile/events/<%= eventItem.id %>/slideshow"><%- include('partials/icon', { name: 'play', size: 16 }) %>Diaporama</a>
            <a class="btn btn-secondary btn-small" href="/profile/events/<%= eventItem.id %>/gallery"><%- include('partials/icon', { name: 'images', size: 16 }) %>Galerie</a>
            <% if (!isClosed) { %>
              <a class="btn btn-secondary btn-small" href="/profile/event/<%= eventItem.id %>/moderation"><%- include('partials/icon', { name: 'shield', size: 16 }) %>Modération</a>
            <% } %>
          </div>

          <div class="event-row-footer">
            <% if (isClosed) { %>
              <div class="archive-cell"
                   data-archive-cell
                   data-event-id="<%= eventItem.id %>"
                   data-archive-status="<%= eventItem.archiveStatus %>">
                <% if (eventItem.archiveStatus === 'ready') { %>
                  <a class="btn btn-small" href="/profile/events/<%= eventItem.id %>/archive">Télécharger le ZIP</a>
                  <small class="muted-note">
                    <%= eventItem.archivePhotoCount || 0 %> photo(s)<% if (eventItem.archiveSizeBytes) { %> &middot; <%= (eventItem.archiveSizeBytes / (1024 * 1024)).toFixed(1) %> Mo<% } %>
                  </small>
                <% } else if (eventItem.archiveStatus === 'failed') { %>
                  <span class="archive-failed">La génération de l'archive a échoué. Contactez un administrateur.</span>
                <% } else { %>
                  <span class="archive-pending">
                    <span class="archive-spinner" aria-hidden="true"></span>
                    Archive ZIP en préparation&hellip; le lien de téléchargement apparaîtra ici dès qu'elle sera prête.
                  </span>
                <% } %>
              </div>
            <% } else { %>
              <div class="table-actions">
                <a class="btn btn-ghost btn-small" href="/profile/events/<%= eventItem.id %>/edit"><%- include('partials/icon', { name: 'edit', size: 16 }) %>Modifier</a>
                <% if (eventItem.status !== 'active') { %>
                  <form method="post" action="/profile/events/<%= eventItem.id %>/activate" class="inline-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <button class="btn btn-ghost btn-small" type="submit"><%- include('partials/icon', { name: 'power', size: 16 }) %>Activer</button>
                  </form>
                <% } %>
              </div>
            <% } %>
            <div class="event-row-danger">
              <% if (!isClosed) { %>
                <button class="btn btn-danger btn-small"
                        type="button"
                        data-close-event-trigger
                        data-event-id="<%= eventItem.id %>"
                        data-event-name="<%= eventItem.name %>"
                        data-pending-count="<%= eventItem.pendingModerationCount || 0 %>"><%- include('partials/icon', { name: 'lock', size: 16 }) %>Clôturer</button>
              <% } %>
              <form method="post" action="/profile/events/<%= eventItem.id %>?_method=DELETE" class="inline-form" onsubmit="return confirm('Supprimer cet événement ? Cette action supprimera aussi toutes les données stockées de cet événement.');">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <button class="btn btn-danger btn-small" type="submit"><%- include('partials/icon', { name: 'trash', size: 16 }) %>Supprimer</button>
              </form>
            </div>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<section class="profile-grid section-gap">
  <article class="card">
    <p class="eyebrow">Compte</p>
    <h2>Mon compte</h2>
    <dl class="definition-list">
      <div>
        <dt>Email</dt>
        <dd><%= user.email %></dd>
      </div>
      <div>
        <dt>Rôle</dt>
        <dd><span class="badge badge-<%= user.role %>"><%= badgeLabels[user.role] || user.role %></span></dd>
      </div>
      <div>
        <dt>Statut</dt>
        <dd><span class="badge badge-<%= user.status %>"><%= badgeLabels[user.status] || user.status %></span></dd>
      </div>
    </dl>
  </article>

  <article class="card">
    <p class="eyebrow">Édition</p>
    <h2>Mettre à jour mon profil</h2>
    <form method="post" action="/profile?_method=PUT" class="form-grid">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <label>
        <span>Nom complet</span>
        <input type="text" name="fullName" value="<%= formData.fullName || user.fullName || '' %>" required maxlength="120" autocomplete="name" />
        <% if (fieldErrors.fullName) { %><small class="field-error"><%= fieldErrors.fullName %></small><% } %>
      </label>

      <div class="form-row">
        <label>
          <span>Nouveau mot de passe</span>
          <input type="password" name="password" minlength="8" maxlength="72" autocomplete="new-password" />
          <% if (fieldErrors.password) { %><small class="field-error"><%= fieldErrors.password %></small><% } %>
        </label>

        <label>
          <span>Confirmation</span>
          <input type="password" name="confirmPassword" minlength="8" maxlength="72" autocomplete="new-password" />
          <% if (fieldErrors.confirmPassword) { %><small class="field-error"><%= fieldErrors.confirmPassword %></small><% } %>
        </label>
      </div>

      <label>
        <span>Mot de passe actuel</span>
        <input type="password" name="currentPassword" maxlength="72" autocomplete="current-password" />
        <% if (fieldErrors.currentPassword) { %><small class="field-error"><%= fieldErrors.currentPassword %></small><% } %>
      </label>

      <button class="btn" type="submit">Enregistrer</button>
    </form>
  </article>
</section>

<!-- Popup de confirmation obligatoire avant cloture definitive -->
<div class="modal-backdrop" id="close-event-modal" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="close-event-modal-title">
  <div class="modal-card">
    <h2 id="close-event-modal-title">Clôturer définitivement l'événement</h2>
    <p>Vous êtes sur le point de clôturer <strong id="close-event-modal-name"></strong>.</p>

    <!-- Etat bloque : il reste des photos non moderees, qui seraient perdues -->
    <div id="close-event-blocked" hidden>
      <p class="modal-danger-note">
        Clôture impossible : <strong id="close-event-pending-count"></strong> attendent encore votre modération.
      </p>
      <p>
        Une photo non modérée n'apparaît ni dans la galerie ni dans l'archive ZIP,
        et la modération devient inaccessible une fois l'événement clôturé :
        elle serait <strong>définitivement perdue</strong>.
      </p>
      <div class="table-actions">
        <button class="btn btn-secondary" type="button" data-close-event-dismiss>Fermer</button>
        <a class="btn" id="close-event-moderation-link" href="#">Aller à la modération</a>
      </div>
    </div>

    <ul class="modal-warning-list" id="close-event-consequences">
      <li>Les invités ne pourront <strong>plus envoyer de photos</strong>.</li>
      <li>L'événement ne pourra <strong>plus être modifié, réactivé ni rouvert</strong>.</li>
      <li>Une archive ZIP de toutes les photos sera préparée en arrière-plan.</li>
    </ul>
    <p class="modal-danger-note" id="close-event-irreversible-note">Cette action est <strong>irréversible</strong>.</p>

    <form method="post" id="close-event-form" class="form-grid">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <label>
        <span>Pour confirmer, saisissez <code>CLOTURER</code></span>
        <input type="text" name="confirmClose" id="close-event-confirm-input" autocomplete="off" required placeholder="CLOTURER" />
      </label>
      <div class="table-actions">
        <button class="btn btn-secondary" type="button" id="close-event-cancel">Annuler</button>
        <button class="btn btn-danger" type="submit" id="close-event-submit" disabled>Clôturer définitivement</button>
      </div>
    </form>
  </div>
</div>

<%- include('partials/footer') %>