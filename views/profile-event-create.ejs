<%- include('partials/head') %>
<%- include('partials/header') %>
<section class="card form-card">
  <div>
    <p class="eyebrow">Mes événements</p>
    <h1>Nouvel événement</h1>
    <p>Renseignez les informations principales, puis activez l'événement quand vous êtes prêt à le partager.</p>
  </div>

  <form method="post" action="/profile/events" class="form-grid section-gap">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <label>
      <span>Nom de l'événement</span>
      <input type="text" name="name" value="<%= formData.name || '' %>" required maxlength="180" />
      <% if (fieldErrors.name) { %><small class="field-error"><%= fieldErrors.name %></small><% } %>
    </label>

    <label>
      <span>Description</span>
      <textarea name="description" required minlength="10" maxlength="5000" rows="5"><%= formData.description || '' %></textarea>
      <% if (fieldErrors.description) { %><small class="field-error"><%= fieldErrors.description %></small><% } %>
    </label>

    <div class="form-row">
    <label>
      <span>Date et heure</span>
      <input type="datetime-local" name="startsAt" value="<%= formData.startsAt || '' %>" required />
      <% if (fieldErrors.startsAt) { %><small class="field-error"><%= fieldErrors.startsAt %></small><% } %>
    </label>

    <label>
      <span>Statut</span>
      <select name="status" required>
        <option value="inactive" <%= (formData.status || 'inactive') === 'inactive' ? 'selected' : '' %>>Inactif</option>
        <option value="active" <%= formData.status === 'active' ? 'selected' : '' %>>Actif</option>
      </select>
      <% if (fieldErrors.status) { %><small class="field-error"><%= fieldErrors.status %></small><% } %>
    </label>
    </div>

    <div class="form-row">
    <label>
      <span>Thème visuel</span>
      <select name="theme" required>
        <% eventThemeOptions.forEach((themeItem) => { %>
          <option value="<%= themeItem.key %>" <%= (formData.theme || 'classic') === themeItem.key ? 'selected' : '' %>>
            <%= themeItem.icon %> <%= themeItem.label %>
          </option>
        <% }) %>
      </select>
      <% if (fieldErrors.theme) { %><small class="field-error"><%= fieldErrors.theme %></small><% } %>
    </label>

    <label>
      <span>Transition du diaporama</span>
      <select name="slideshowTransition" required>
        <% eventTransitionOptions.forEach((transitionItem) => { %>
          <option value="<%= transitionItem.key %>" <%= (formData.slideshowTransition || 'fade') === transitionItem.key ? 'selected' : '' %>>
            <%= transitionItem.label %>
          </option>
        <% }) %>
      </select>
      <% if (fieldErrors.slideshowTransition) { %><small class="field-error"><%= fieldErrors.slideshowTransition %></small><% } %>
    </label>
    </div>

    <label>
      <span>Source des photos</span>
      <select name="uploadSourceMode" required>
        <option value="default" <%= (formData.uploadSourceMode || 'default') === 'default' ? 'selected' : '' %>>Par défaut</option>
        <option value="camera_only" <%= formData.uploadSourceMode === 'camera_only' ? 'selected' : '' %>>Caméra uniquement</option>
        <option value="library_only" <%= formData.uploadSourceMode === 'library_only' ? 'selected' : '' %>>Photothèque uniquement</option>
      </select>
      <% if (fieldErrors.uploadSourceMode) { %><small class="field-error"><%= fieldErrors.uploadSourceMode %></small><% } %>
    </label>

    <label>
      <span class="checkbox-label">
        <input type="checkbox" name="uploadAllowMultiple" value="1" <%= formData.uploadAllowMultiple !== false ? 'checked' : '' %> />
        Autoriser plusieurs photos d'affilée
      </span>
      <% if (fieldErrors.uploadAllowMultiple) { %><small class="field-error"><%= fieldErrors.uploadAllowMultiple %></small><% } %>
    </label>

    <label>
      <span class="checkbox-label">
        <input type="checkbox" name="moderationEnabled" value="1" <%= formData.moderationEnabled ? 'checked' : '' %> />
        Activer la modération avant publication (galerie et diaporama)
      </span>
      <% if (fieldErrors.moderationEnabled) { %><small class="field-error"><%= fieldErrors.moderationEnabled %></small><% } %>
    </label>

    <div class="table-actions">
      <button class="btn" type="submit">Créer l'événement</button>
      <a class="btn btn-secondary" href="/profile">Annuler</a>
    </div>
  </form>
</section>
<%- include('partials/footer') %>
