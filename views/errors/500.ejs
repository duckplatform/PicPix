<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title || 'Erreur serveur' %> - PicPix</title>
    <%- include('../partials/fonts') %>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class="<%= pageClass || '' %>">
    <main class="container error-page">
      <section class="card error-card">
        <p class="error-code"><%= typeof statusCode !== 'undefined' ? statusCode : 500 %></p>
        <h1><%= typeof message !== 'undefined' ? message : 'Une erreur est survenue.' %></h1>
        <p>Réessayez dans quelques instants. Si le problème persiste, contactez l'organisateur.</p>
        <div class="hero-actions">
          <a class="btn" href="/">Retour à l'accueil</a>
        </div>
      </section>
    </main>
  </body>
</html>
