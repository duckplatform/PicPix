<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= editingEvent.name %> - Slideshow</title>
    <%- include('partials/fonts') %>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class="slideshow-fullscreen-body event-theme-<%= eventTheme ? eventTheme.key : 'classic' %>">

    <div class="slideshow-shell"
      id="slideshow-shell"
      data-event-id="<%= editingEvent.id %>"
      data-event-name="<%= editingEvent.name %>"
      data-transition="<%= slideshowTransition || 'fade' %>"
      data-initial-photos="<%= JSON.stringify(initialPhotos || []) %>"
      data-status="<%= editingEvent.status %>"
      data-starts-at="<%= eventStartsAtIso || '' %>"
      data-now="<%= nowIso %>"
      data-show-countdown="<%= shouldShowCountdown ? '1' : '0' %>">

      <header class="slideshow-event-banner" aria-label="Nom de l'evenement">
        <span class="slideshow-event-pill <%= editingEvent.status === 'inactive' ? 'slideshow-event-pill-idle' : '' %>"><%= eventTheme ? eventTheme.icon : '✦' %> <%= editingEvent.status === 'inactive' ? 'Bientôt' : 'En direct' %></span>
        <h1 class="slideshow-event-name"><%= editingEvent.name %></h1>
      </header>

      <div class="slideshow-vignette" aria-hidden="true"></div>

      <% if (shouldShowCountdown) { %>
        <div class="slideshow-waiting slideshow-countdown" aria-live="polite">
          <p>L'événement commence dans</p>
          <div id="slideshow-countdown-value" class="slideshow-countdown-value">--:--:--</div>
        </div>
      <% } else if (editingEvent.status === 'inactive') { %>
        <div class="slideshow-waiting">
          L'événement va bientôt commencer…
        </div>
      <% } else { %>
        <div id="slideshow-waiting" class="slideshow-waiting">
          En attente des premières photos…
        </div>
      <% } %>

      <figure id="slideshow-figure" class="slideshow-figure" hidden>
        <img id="slideshow-image" class="slideshow-image" alt="Photo de l'evenement" />
        <figcaption id="slideshow-caption" class="slideshow-caption"></figcaption>
      </figure>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/profile-event-slideshow.js"></script>
  </body>
</html>
